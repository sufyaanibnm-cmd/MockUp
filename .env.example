# Optional overrides for src/lib/contactEmail.ts. The configured public
# identifiers in that module work without an environment file.
# Copy this file to .env.local only when using a different EmailJS account.
# VITE_ values are included in browser code; never use a private API key here.
#
# Template body: user_name, user_email, user_phone, message.
# To Email: hi@shaffedits.com (fixed in the EmailJS template).
# From Name: Shaffedits Website. From Email: Default Email Address checked.
# Reply To: {{user_email}}. Cc/Bcc: empty.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
